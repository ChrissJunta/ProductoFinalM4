# Copiar a .env y ajustar. El archivo .env nunca se sube al repositorio.

# Django. El módulo de settings NO se elige aquí (se lee antes que este archivo):
# manage.py usa config.settings.dev; wsgi/asgi usan config.settings.prod. En el servidor
# exportar DJANGO_SETTINGS_MODULE=config.settings.prod también para migrate y cron.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Cookies solo por HTTPS (True en producción)
DJANGO_SECURE_COOKIES=False
# Zona horaria institucional (Universidad Indoamérica, Ecuador). Afecta fechas mostradas y SLA.
TIME_ZONE=America/Guayaquil

# PostgreSQL
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Feriados para el calendario laboral del SLA (fechas ISO separadas por coma)
HOLIDAYS=

# Proveedor de datos institucionales: local (simulado) | sga (BE-T19)
INSTITUTIONAL_PROVIDER=local
# Con sga: URL del SGA (o del simulado: python manage.py run_sga_mock)
SGA_BASE_URL=
SGA_TOKEN=
SGA_TIMEOUT=5

# Proveedor LLM (ADR-069): fake = simulado, sin red | openai_compat = servidor vLLM (Qwen3-8B)
LLM_PROVIDER=fake
# Con openai_compat (red de la universidad; probar con: python manage.py llm_ping).
# Para activar una línea, borra el «#» y el espacio: la línea debe empezar en la clave.
# Sin comentarios al final de la línea: el lector de .env no los admite.
#LLM_BASE_URL=http://172.16.8.69:8000/v1
#LLM_MODEL=Qwen/Qwen3-8B-AWQ
#LLM_TIMEOUT=20
#LLM_ENABLE_THINKING=False
# Si el servidor no responde, usar el simulado:
#LLM_FALLBACK_PROVIDER=fake

# Persistencia de los hilos del agente LangGraph: postgres (recomendado) | memory
AGENT_CHECKPOINTER=postgres

# WhatsApp (ADR-049): simulated (sin Meta) | cloud (requiere las credenciales de Meta)
WHATSAPP_MODE=simulated
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Producción (BE-T20, SPEC §48) ---------------------------------------------
#DJANGO_ALLOWED_HOSTS=mesa.universidad.edu
#DJANGO_CSRF_TRUSTED_ORIGINS=https://mesa.universidad.edu
#DJANGO_SECURE_COOKIES=True
#DJANGO_SECURE_SSL_REDIRECT=True
#DJANGO_HSTS_SECONDS=31536000
# Número de proxies inversos delante de Django (IP real y HTTPS):
#TRUSTED_PROXY_COUNT=1
# Caché compartida entre procesos (ejecutar python manage.py createcachetable):
#CACHE_BACKEND=db
# Solo con workers fijos y workers × hilos < max_connections:
#POSTGRES_CONN_MAX_AGE=60

