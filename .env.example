# Copiar a .env y ajustar. El archivo .env nunca se sube al repositorio.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Cookies solo por HTTPS (True en producción)
DJANGO_SECURE_COOKIES=False
# Zona horaria institucional (Universidad Indoamérica, Ecuador). Afecta fechas mostradas y SLA.
TIME_ZONE=America/Guayaquil

# PostgreSQL
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Feriados para el calendario laboral del SLA (fechas ISO separadas por coma)
HOLIDAYS=
